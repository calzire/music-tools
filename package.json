{
  "name": "music-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsc scripts/drumLooper.generator.ts --module nodenext --moduleResolution nodenext --target es2022 --outDir .tmp/generators && node .tmp/generators/drumLooper.generator.js",
    "prebuild": "pnpm exec tsc scripts/drumLooper.generator.ts --module nodenext --moduleResolution nodenext --target es2022 --outDir .tmp/generators && node .tmp/generators/drumLooper.generator.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.166.2",
    "@tanstack/zod-adapter": "^1.166.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.563.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tone": "^15.1.22",
    "vaul-base": "^1.0.0",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5",
      "serialize-javascript": ">=7.0.3",
      "flatted": "3.4.2",
      "picomatch@^2": "2.3.2",
      "picomatch@^4": "4.0.4"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
